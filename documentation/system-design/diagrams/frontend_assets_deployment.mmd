graph TD
    %% Source Code tier
    subgraph Repository ["Developer Workspace / Repository"]
        SrcCode["Vite Frontend: /src"]
        SharedDocs["Shared Wall Docs: /shared"]
        FrierenAssets["Frieren Pack: /public_frieren"]
        TamonAssets["Tamon Pack: /public_tamon_b_side"]
    end

    %% Build & Compilation phase
    BuildStep["1. npm run build <br> (Generates static files in /dist)"]
    ConfigInject["2. Inject dynamic config.json <br> (Saves API URLs & Default Pack info)"]

    %% CDK S3 Deployments
    subgraph Deployments ["AWS CDK Bucket Deployments"]
        DeployMain["CDK: DeployFrontend <br> Uploads /dist + config.json"]
        DeployShared["CDK: DeploySharedFiles <br> Uploads /shared"]
        DeployFrieren["CDK: DeployAssetPackFrieren <br> Uploads /public_frieren to assets/frieren/"]
        DeployTamon["CDK: DeployAssetPackTamon <br> Uploads /public_tamon_b_side to assets/tamon/"]
    end

    %% S3 Buckets target
    subgraph TargetBuckets ["AWS S3 Target Buckets"]
        S3Website["S3 Website Bucket <br> (Private Website Root)"]
        S3Shared["S3 Shared Files Bucket <br> (Resource Wall Docs)"]
    end

    %% CloudFront Edge Layer
    subgraph CDNLayer ["High Performance CDN Cache Layer"]
        CF["CloudFront Distribution"]
        InvalAll["Cache Invalidation: /*"]
        InvalFrieren["Cache Invalidation: /assets/frieren/*"]
        InvalTamon["Cache Invalidation: /assets/tamon/*"]
    end

    %% Flow arrows
    SrcCode --> BuildStep
    BuildStep --> DeployMain
    ConfigInject --> DeployMain

    SharedDocs --> DeployShared
    FrierenAssets --> DeployFrieren
    TamonAssets --> DeployTamon

    DeployMain -->|Write files| S3Website
    DeployFrieren -->|Write prefix assets/frieren/| S3Website
    DeployTamon -->|Write prefix assets/tamon/| S3Website
    DeployShared -->|Write files| S3Shared

    DeployMain -->|3. Trigger invalidation| CF
    DeployFrieren -->|Trigger invalidation| CF
    DeployTamon -->|Trigger invalidation| CF

    CF --> InvalAll
    CF --> InvalFrieren
    CF --> InvalTamon

    %% Styles
    classDef SrcStyle fill:#E1F5FE,stroke:#03A9F4,stroke-width:2px,color:#01579B;
    classDef BuildStyle fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#263238;
    classDef CDKStyle fill:#FFE082,stroke:#FFB300,stroke-width:2px,color:#5D4037;
    classDef S3Style fill:#E0F2F1,stroke:#009688,stroke-width:2px,color:#004D40;
    classDef CFStyle fill:#E8EAF6,stroke:#3F51B5,stroke-width:2px,color:#1A237E;

    class SrcCode,SharedDocs,FrierenAssets,TamonAssets SrcStyle;
    class BuildStep,ConfigInject BuildStyle;
    class DeployMain,DeployShared,DeployFrieren,DeployTamon CDKStyle;
    class S3Website,S3Shared S3Style;
    class CF,InvalAll,InvalFrieren,InvalTamon CFStyle;
