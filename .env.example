# Copy this file to .env.local and adjust values for your environment.
# .env.local is gitignored and will NOT be committed.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Root directory of your OpenClaw installation/config.
# Used to locate openclaw.json and, by default, the shared resource wall files.
# Default: ~/.openclaw
# OPENCLAW_HOME=~/.openclaw

# Backend mode:
# - local     = read ~/.openclaw/openclaw.json and connect to a local gateway
# - agentcore = invoke the deployed AgentCore runtime for snapshots
# Default: local
# OPENCLAW_BACKEND_MODE=local

# AgentCore dashboard bridge mode
# Required when OPENCLAW_BACKEND_MODE=agentcore
# AGENTCORE_REGION=us-east-1
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/openclaw_agent_v2_dev-abc123
# AGENTCORE_RUNTIME_ENDPOINT_ID=openclaw_endpoint_dev
# AGENTCORE_ACTOR_ID=telegram:123456
#
# Optional overrides
# AGENTCORE_CHANNEL=telegram
# AGENTCORE_USER_ID=dashboard-user-custom
# AGENTCORE_RUNTIME_SESSION_ID=dashboard_custom
#
# Optional live-event relay URL for the deployed bridge.
# If unset, the dashboard falls back to polling AgentCore for normalized events.
# The server auto-adds userId, actorId, and channel query params when missing.
# AGENTCORE_BRIDGE_WS_URL=wss://your-bridge-host/ws
#
# Optional polling interval for AgentCore event relay fallback (milliseconds).
# Default: 2000
# AGENTCORE_EVENT_POLL_MS=2000

# Port for the local OpenClaw API server (used by the dev-server proxy).
# Default: 3001
#
# VITE_API_PORT=3001

# How long a recent user-facing session keeps an agent in the "working" state.
# Default: 10000 (10 seconds)
# VITE_SESSION_ACTIVE_THRESHOLD_MS=10000

# ---------------------------------------------------------------------------
# Asset pack directory
# ---------------------------------------------------------------------------
# Path to the directory served as the Vite public root.
# All static assets (world.json, clip-defs.json, images/) must live here.
# Supports absolute paths and paths relative to the project root.
# Default: ./public
#
# VITE_PUBLIC_DIR=./public
# VITE_PUBLIC_DIR=./public_frieren
# VITE_PUBLIC_DIR=/Users/yourname/my-asset-pack
# VITE_PUBLIC_DIR=../shared-assets/pack-a

# ---------------------------------------------------------------------------
# Shared files root
# ---------------------------------------------------------------------------
# Path to the directory the resource wall file browser serves.
# Supports absolute paths and paths relative to the project root.
# Default: <OPENCLAW_HOME>/shared
#
# SHARED_ROOT=~/.openclaw/shared
# SHARED_ROOT=/path/to/custom/shared

# ---------------------------------------------------------------------------
# UI Customization
# ---------------------------------------------------------------------------
# Text displayed in the top banner of the dashboard.
VITE_BANNER_TEXT=HKIIT 雲端系統及數據中心管理高級文憑
