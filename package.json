{
  "name": "openclaw-character-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server --ext .ts,.tsx",
    "lint:fix": "eslint src server --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "cdk": "cdk",
    "deploy": "tsx infra/deploy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1058.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1057.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1061.0",
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/lib-dynamodb": "^3.1057.0",
    "@types/aws-lambda": "^8.10.161",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "highlight.js": "^11.9.0",
    "mime-types": "^2.1.35",
    "phaser": "^3.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "ws": "^8.22.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "concurrently": "^8.2.2",
    "constructs": "^10.6.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "form-data": "4.0.6"
  }
}
